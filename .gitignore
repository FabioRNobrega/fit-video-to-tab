.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# Packed extension artifacts (built locally, not source)
*.zip
*.crx
*.pem

# Internal agent/spec working docs — not part of the shipped project
AGENTS.md
Specs/
