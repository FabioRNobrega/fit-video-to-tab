{
  "manifest_version": 3,
  "name": "Fit Video to Tab",
  "short_name": "Fit Video",
  "version": "1.4.0",
  "description": "Frame the moment. Instantly expand any video to fill your tab and cut the clutter — on YouTube, Reddit, X, and beyond.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "24": "icon24.png",
      "32": "icon32.png"
    },
    "default_title": "Fit Video to Tab"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ancestorOverrides.js", "fillTab.js", "drag.js", "fillControls.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://*.redgifs.com/*",
        "*://*.imgur.com/*",
        "*://*.streamable.com/*"
      ],
      "js": ["ancestorOverrides.js", "fillControls.js", "redditFill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtubeFill.js"],
      "run_at": "document_idle"
    }
  ]
}
