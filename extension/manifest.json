{
  "manifest_version": 3,
  "name": "Fill Video",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ancestorOverrides.js", "fillTab.js", "drag.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://*.redgifs.com/*",
        "*://*.imgur.com/*",
        "*://*.streamable.com/*"
      ],
      "js": ["ancestorOverrides.js", "reddit_fill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
