{
  "manifest_version": 3,
  "name": "Fit Video to Tab",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ancestorOverrides.js", "fillTab.js", "drag.js", "fillControls.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://*.redgifs.com/*",
        "*://*.imgur.com/*",
        "*://*.streamable.com/*"
      ],
      "js": ["ancestorOverrides.js", "fillControls.js", "reddit_fill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
